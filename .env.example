# Copy this template to .env and enter settings only in that local file.
# Use a browser-safe publishable key. Never a secret/service-role key or password.
# Base project URL only; server.mjs rejects API paths and non-public keys.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Team schema name is case-sensitive. Use user_reports only for the fresh lowercase schema.
SUPABASE_REPORTS_TABLE=ReportSpotStatus
